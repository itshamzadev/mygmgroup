NODE_ENV=production
PORT=5000

# Use your MongoDB server or MongoDB Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/mygm_group

# Generate with: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

ADMIN_EMAIL=admin@mygmgroup.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# Use the public URL where this React website will be served.
FRONTEND_URL=https://mygmgroup.com

# Existing Ubuntu Postfix/Dovecot + PostfixAdmin SQLite setup.
MAIL_DOMAIN=mygmgroup.com
MAIL_DB_PATH=/www/vmail/postfixadmin.db
WEBMAIL_URL=https://mail.mygmgroup.com
